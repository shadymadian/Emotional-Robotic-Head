<?xml version="1.0"?>
<robot name="eye_robot">

  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>  <!-- Weißes Material -->
  </material>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>  <!-- Graues Material -->
  </material>

  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>  <!-- Schwarzes Material für Basis -->
  </material>

  <material name="red">
    <color rgba="1.0 0.0 0.0 1.0"/>  <!-- Rotes Material für Basis -->
  </material>

  <link name="base_link"/>

  <link name="head_base_link"/>

  <link name="head">
    <visual>
      <geometry>
        <box size="0.2 0.35 0.4"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <link name="neck">
    <visual>
      <geometry>
        <cylinder radius="0.08" length="0.1"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <link name="cam">
    <visual>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <link name="motor_3_1">
    <visual>
      <geometry>
        <cylinder radius="0.01" length="0.1"/> 
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <link name="motor_3_2">
    <visual>
      <geometry>
        <cylinder radius="0.01" length="0.1"/> 
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <link name="motor_3_3">
    <visual>
      <geometry>
        <cylinder radius="0.01" length="0.1"/> 
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <joint name="base_neck" type="fixed">
    <parent link="base_link"/>
    <child link="neck"/>
    <origin xyz="0 0 0.05" rpy="0 0 0" />
  </joint>

  <joint name="base_cam" type="fixed">
    <parent link="base_link"/>
    <child link="cam"/>
    <origin xyz="0.2 0 0.005" rpy="0 0 0" />
  </joint>

  <joint name="neck_motor_3_1" type="fixed">
    <parent link="neck"/>
    <child link="motor_3_1"/>
    <origin xyz="0 0 0.04" rpy="0 0 0" />
  </joint>
  
  <joint name="joint_3_1" type="revolute">
    <parent link="motor_3_1"/>
    <child link="motor_3_2"/>
    <origin xyz="0 0 0.01" rpy="0 0 0" />
    <axis xyz="1 0 0"/> 
    <limit lower="-0.26" upper="0.26" effort="10.0" velocity="1.0"/>
  </joint>

  <joint name="joint_3_2" type="revolute">
    <parent link="motor_3_2"/>
    <child link="motor_3_3"/>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
  </joint>

  <joint name="joint_3_3" type="revolute">
    <parent link="motor_3_3"/>
    <child link="head_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 -1 0"/>
    <limit lower="-0.52" upper="0.05" effort="10.0" velocity="1.0"/>
  </joint>

  <joint name="head_base" type="fixed">
    <parent link="head_base_link"/>
    <child link="head"/>
    <origin xyz="0 0 0.2" rpy="0 0 0" />
  </joint>
  
  <link name="eye_ball_1">
    <visual>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="white"/>
    </visual>
  </link>
  
  <link name="pupil_1">
    <visual>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  
  <link name="motor_1_1">
    <visual>
      <geometry>
        <cylinder radius="0.01" length="0.1"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  
  <link name="motor_1_2">
    <visual>
      <geometry>
        <cylinder radius="0.01" length="0.1"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <link name="motor_1_3">
    <visual>
      <geometry>
        <cylinder radius="0.01" length="0.1"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <link name="eyelid_1">
    <visual>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <link name="eyelid_base_1">
    <visual>
      <geometry>
        <sphere radius="0.001"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <link name="motor_1_4">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.57 0" />
      <geometry>
        <cylinder radius="0.01" length="0.05"/> 
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <link name="motor_1_5">
    <visual>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <link name="motor_1_6">
    <visual>
      <origin xyz="0 0.03 0" rpy="0 1.57 0" />
      <geometry>
        <cylinder radius="0.01" length="0.05"/> 
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <link name="eye_braun_1_1">
    <visual>
      <origin xyz="0.02 0.02 0" rpy="0 0 0" />
      <geometry>
        <box size="0.01 0.05 0.01"/> 
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <link name="eye_braun_1_2">
    <visual>
      <origin xyz="0.02 -0.02 0" rpy="0 0 0" />
      <geometry>
        <box size="0.01 0.05 0.01"/> 
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <joint name="head_motor_1_1" type="fixed">
    <parent link="head"/>
    <child link="motor_1_1"/>
    <origin xyz="0.1 -0.1 0.1" rpy="0 0 0" />
  </joint>

  <joint name="joint_1_1" type="revolute">
    <parent link="motor_1_1"/>
    <child link="motor_1_2"/>
    <axis xyz="0 0 1"/> 
    <limit lower="-0.785" upper="0.785" effort="10.0" velocity="1.0"/>
  </joint>

  <joint name="joint_1_2" type="revolute">
    <parent link="motor_1_2"/>
    <child link="eye_ball_1"/>
    <axis xyz="0 1 0"/> 
    <limit lower="-0.785" upper="0.785" effort="10.0" velocity="1.0"/>
  </joint>

  <joint name="joint_1_3" type="revolute">
    <parent link="motor_1_3"/>
    <child link="eyelid_base_1"/>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 -1 0"/>
    <limit lower="-0.785" upper="0.34" effort="10.0" velocity="1.0"/>
  </joint>

  <joint name="eyelid_base_1" type="fixed">
    <parent link="eyelid_base_1"/>
    <child link="eyelid_1"/>
    <origin xyz="0 0 0.015" rpy="0 0 0" />
  </joint>

  <joint name="eye_pupil_1" type="fixed">
    <parent link="eye_ball_1"/>
    <child link="pupil_1"/>
    <origin xyz="0.012 0 0" rpy="0 0 0" />
  </joint>

  <joint name="head_base_motor_1_3" type="fixed">
    <parent link="head"/>
    <child link="motor_1_3"/>
    <origin xyz="0.1 -0.1 0.1" rpy="0 0 0" />
  </joint>

  <joint name="head_motor_1_4" type="fixed">
    <parent link="head"/>
    <child link="motor_1_4"/>
    <origin xyz="0.1 -0.16 0.16" rpy="0 0 0" />
  </joint>

  <joint name="joint_1_4" type="revolute">
    <parent link="motor_1_4"/>
    <child link="eye_braun_1_1"/>
    <axis xyz="1 0 0"/> 
    <limit lower="-0.4" upper="0.4" effort="10.0" velocity="1.0"/>
  </joint>

  <joint name="head_motor_1_5" type="fixed">
    <parent link="head"/>
    <child link="motor_1_5"/>
    <origin xyz="0.1 -0.08 0.16" rpy="0 0 0" />
  </joint>

  <joint name="joint_1_5" type="revolute">
    <parent link="motor_1_5"/>
    <child link="motor_1_6"/>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="-1 0 0"/> 
    <limit lower="-0.14" upper="0.0" effort="10.0" velocity="1.0"/>
  </joint>

  <joint name="joint_1_6" type="revolute">
    <parent link="motor_1_6"/>
    <child link="eye_braun_1_2"/>
    <origin xyz="0 0.03 0" rpy="0 0 0" />
    <axis xyz="1 0 0"/> 
    <limit lower="-0.4" upper="0.4" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="eye_ball_2">
    <visual>
      <geometry>
        <sphere radius="0.05"/> 
      </geometry>
      <material name="white"/>
    </visual>
  </link>
  
  <link name="pupil_2">
    <visual>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <link name="motor_2_1">
    <visual>
      <geometry>
        <cylinder radius="0.01" length="0.1"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <link name="motor_2_2">
    <visual>
      <geometry>
        <cylinder radius="0.01" length="0.1"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <link name="motor_2_3">
    <visual>
      <geometry>
        <cylinder radius="0.01" length="0.1"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <link name="eyelid_2">
    <visual>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <link name="eyelid_base_2">
    <visual>
      <geometry>
        <sphere radius="0.001"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <link name="motor_2_4">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.57 0" />
      <geometry>
        <cylinder radius="0.01" length="0.05"/> 
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <link name="motor_2_5">
    <visual>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <link name="motor_2_6">
    <visual>
      <origin xyz="0 -0.03 0" rpy="0 1.57 0" />
      <geometry>
        <cylinder radius="0.01" length="0.05"/> 
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <link name="eye_braun_2_1">
    <visual>
      <origin xyz="0.02 -0.02 0" rpy="0 0 0" />
      <geometry>
        <box size="0.01 0.05 0.01"/> 
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <link name="eye_braun_2_2">
    <visual>
      <origin xyz="0.02 0.02 0" rpy="0 0 0" />
      <geometry>
        <box size="0.01 0.05 0.01"/> 
      </geometry>
      <material name="grey"/>
    </visual>
  </link>
  
  <joint name="head_base_motor_2_1" type="fixed">
    <parent link="head"/>
    <child link="motor_2_1"/>
    <origin xyz="0.1 0.1 0.1" rpy="0 0 0" />
  </joint>

  <joint name="joint_2_1" type="revolute">
    <parent link="motor_2_1"/>
    <child link="motor_2_2"/>
    <axis xyz="0 0 1"/> 
    <limit lower="-0.785" upper="0.785" effort="10.0" velocity="1.0"/>
  </joint>

  <joint name="joint_2_2" type="revolute">
    <parent link="motor_2_2"/>
    <child link="eye_ball_2"/>
    <axis xyz="0 -1 0"/> 
    <limit lower="-0.785" upper="0.785" effort="10.0" velocity="1.0"/>
  </joint>

  <joint name="joint_2_3" type="revolute">
    <parent link="motor_2_3"/>
    <child link="eyelid_base_2"/>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0"/>
    <limit lower="-0.34" upper="0.785" effort="10.0" velocity="1.0"/>
  </joint>

  <joint name="eyelid_base_2" type="fixed">
    <parent link="eyelid_base_2"/>
    <child link="eyelid_2"/>
    <origin xyz="0 0 0.015" rpy="0 0 0" />
  </joint>

  <joint name="eye_pupil_2" type="fixed">
    <parent link="eye_ball_2"/>
    <child link="pupil_2"/>
    <origin xyz="0.012 0 0" rpy="0 0 0" />
  </joint>

  <joint name="head_base_motor_2_3" type="fixed">
    <parent link="head"/>
    <child link="motor_2_3"/>
    <origin xyz="0.1 0.1 0.1" rpy="0 0 0" />
  </joint>

  <joint name="head_motor_2_4" type="fixed">
    <parent link="head"/>
    <child link="motor_2_4"/>
    <origin xyz="0.1 0.16 0.16" rpy="0 0 0" />
  </joint>

  <joint name="joint_2_4" type="revolute">
    <parent link="motor_2_4"/>
    <child link="eye_braun_2_1"/>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0"/> 
    <limit lower="-0.4" upper="0.4" effort="10.0" velocity="1.0"/>
  </joint>

  <joint name="head_motor_2_5" type="fixed">
    <parent link="head"/>
    <child link="motor_2_5"/>
    <origin xyz="0.1 0.08 0.16" rpy="0 0 0" />
  </joint>

  <joint name="joint_2_5" type="revolute">
    <parent link="motor_2_5"/>
    <child link="motor_2_6"/>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0"/> 
    <limit lower="0.0" upper="0.14" effort="10.0" velocity="1.0"/>
